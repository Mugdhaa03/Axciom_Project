@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{ ViewData["Title"]="Follow-ups"; }<div class="d-flex justify-content-between mb-3"><h1>Follow-ups</h1><a class="btn btn-primary" asp-action="Create">Schedule Follow-up</a></div><table class="table"><thead><tr><th>Date</th><th>Type</th><th>Remarks</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.FollowUpDate.ToShortDateString()</td><td>@x.FollowUpType</td><td>@x.Remarks</td><td>@x.Status</td><td>@if(x.Status=="Planned"){<form asp-action="Complete" method="post"><input type="hidden" name="id" value="@x.FollowUpId"><button class="btn btn-sm btn-outline-success">Complete</button></form>}</td></tr>}</tbody></table>
