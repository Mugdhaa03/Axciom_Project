@model AcxiomCRM.Models.FollowUp
@{ ViewData["Title"]="Schedule Follow-up"; }<h1>Schedule Follow-up</h1><form asp-action="Create" method="post" class="row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-4"><label asp-for="FollowUpDate"></label><input asp-for="FollowUpDate" class="form-control"><span asp-validation-for="FollowUpDate" class="text-danger"></span></div><div class="col-md-4"><label asp-for="FollowUpType"></label><select asp-for="FollowUpType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div><div class="col-md-4"><label asp-for="CustomerId"></label><select asp-for="CustomerId" class="form-select" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(ViewBag.Customers, "CustomerId", "CustomerName"))"><option value="">Select customer</option></select></div><div class="col-12"><label asp-for="Remarks"></label><textarea asp-for="Remarks" class="form-control"></textarea></div><button class="btn btn-primary">Schedule</button></form>
