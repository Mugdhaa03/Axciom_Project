@model IEnumerable<AcxiomCRM.Models.Lead>
@{ ViewData["Title"]="Leads"; }<div class="d-flex justify-content-between mb-3"><h1>Leads</h1><a class="btn btn-primary" asp-action="Create">Add Lead</a></div><form class="input-group mb-3"><input name="search" class="form-control" placeholder="Search leads"><button class="btn btn-outline-secondary">Search</button></form><table class="table table-hover"><thead><tr><th>Lead</th><th>Company</th><th>Status</th><th>Value</th><th>Owner</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.LeadName</td><td>@x.CompanyName</td><td><span class="badge bg-info">@x.Status</span></td><td>@x.ExpectedValue.ToString("C")</td><td>@x.AssignedTo</td></tr>}</tbody></table>
