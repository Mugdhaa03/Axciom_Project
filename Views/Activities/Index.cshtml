@model IEnumerable<AcxiomCRM.Models.Activity>
@{ ViewData["Title"]="Activities"; }<div class="d-flex justify-content-between mb-3"><h1>Activities</h1><a class="btn btn-primary" asp-action="Create">Add Activity</a></div><table class="table"><thead><tr><th>Date</th><th>Type</th><th>Subject</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.ActivityDate.ToShortDateString()</td><td>@x.ActivityType</td><td>@x.Subject</td><td>@x.Status</td></tr>}</tbody></table>
