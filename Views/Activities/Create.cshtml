@model AcxiomCRM.Models.Activity
@{ ViewData["Title"]="Add Activity"; }<h1>Add Activity</h1><form asp-action="Create" method="post" class="row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-4"><label asp-for="ActivityType"></label><select asp-for="ActivityType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div><div class="col-md-8"><label asp-for="Subject"></label><input asp-for="Subject" class="form-control"><span asp-validation-for="Subject" class="text-danger"></span></div><div class="col-12"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control"></textarea></div><button class="btn btn-primary">Save Activity</button></form>
