@{ ViewData["Title"] = "Welcome"; }
<section class="landing-page">
    <div class="landing-copy">
        <div class="eyebrow">Customer relationships, simplified</div>
        <h1>Build stronger relationships.<br /><span>Close more opportunities.</span></h1>
        <p>AcxiomCRM gives your team one clear view of customers, leads, follow-ups, and your sales pipeline.</p>
        <div class="landing-actions">
            <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Login">Sign in to workspace <span>→</span></a>
            <a class="btn btn-link btn-lg" asp-area="Identity" asp-page="/Account/Register">Create an account</a>
        </div>
        <div class="landing-proof"><span class="status-dot"></span> Secure workspace · Role-based access · Live insights</div>
    </div>
    <div class="landing-visual">
        <div class="visual-glow"></div>
        <div class="preview-card">
            <div class="preview-top"><strong>Pipeline overview</strong><span>● Live</span></div>
            <div class="preview-total">$248,500 <small>active pipeline</small></div>
            <div class="preview-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
            <div class="preview-labels"><span>Jan</span><span>Feb</span><span>Mar</span><span>Apr</span><span>May</span><span>Jun</span><span>Jul</span></div>
            <div class="preview-stats"><div><b>42</b><small>Open deals</small></div><div><b>68%</b><small>Win rate</small></div><div><b>+24%</b><small>Growth</small></div></div>
        </div>
    </div>
</section>
