@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{ ViewData["Title"]="Opportunities"; }<div class="d-flex justify-content-between mb-3"><h1>Opportunities</h1><a class="btn btn-primary" asp-action="Create">Add Opportunity</a></div><table class="table table-hover"><thead><tr><th>Name</th><th>Amount</th><th>Stage</th><th>Probability</th><th>Close Date</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.OpportunityName</td><td>@x.Amount.ToString("C")</td><td>@x.Stage</td><td>@x.Probability%</td><td>@x.ExpectedCloseDate.ToShortDateString()</td><td>@x.Status</td></tr>}</tbody></table>
