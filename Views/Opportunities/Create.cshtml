@model AcxiomCRM.Models.Opportunity
@{ ViewData["Title"]="Add Opportunity"; }<h1>Add Opportunity</h1><form asp-action="Create" method="post" class="row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-6"><label asp-for="OpportunityName"></label><input asp-for="OpportunityName" class="form-control"><span asp-validation-for="OpportunityName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="CustomerId"></label><select asp-for="CustomerId" class="form-select" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(ViewBag.Customers, "CustomerId", "CustomerName"))"><option value="">Select customer</option></select><span asp-validation-for="CustomerId" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Amount"></label><input asp-for="Amount" class="form-control"><span asp-validation-for="Amount" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Probability"></label><input asp-for="Probability" class="form-control"><span asp-validation-for="Probability" class="text-danger"></span></div><div class="col-md-4"><label asp-for="ExpectedCloseDate"></label><input asp-for="ExpectedCloseDate" class="form-control"><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Stage"></label><select asp-for="Stage" class="form-select"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select></div><button class="btn btn-primary">Save Opportunity</button></form>
