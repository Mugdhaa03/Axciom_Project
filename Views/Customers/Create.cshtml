@model AcxiomCRM.Models.Customer
@{ ViewData["Title"]="Add Customer"; }
<h1>Add Customer</h1><form asp-action="Create" method="post" class="row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
@foreach(var field in new[]{"CustomerName","Email","Phone","CompanyName","Address","City","State"}) { <div class="col-md-6"><label class="form-label">@field</label><input name="@field" class="form-control" value="@Model.GetType().GetProperty(field)?.GetValue(Model)"><span class="text-danger" data-valmsg-for="@field"></span></div> }
<div class="col-12"><button class="btn btn-primary">Save Customer</button> <a asp-action="Index" class="btn btn-link">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
