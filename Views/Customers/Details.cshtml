@model AcxiomCRM.Models.Customer
@{ ViewData["Title"]="Customer Details"; }<h1>@Model.CustomerName</h1><dl class="row"><dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd></dl><a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary">Edit</a>
