@model IEnumerable<AcxiomCRM.Models.Customer>
@{ ViewData["Title"]="Customers"; }
<div class="d-flex justify-content-between mb-3"><h1>Customers</h1><a class="btn btn-primary" asp-action="Create">Add Customer</a></div>
<form class="input-group mb-3"><input name="search" class="form-control" placeholder="Search customers..." value="@Context.Request.Query["search"]"><button class="btn btn-outline-secondary">Search</button></form>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Name</th><th>Company</th><th>Email</th><th>Phone</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a asp-action="Details" asp-route-id="@x.CustomerId">@x.CustomerName</a></td><td>@x.CompanyName</td><td>@x.Email</td><td>@x.Phone</td><td><span class="badge bg-@(x.Status=="Active"?"success":"secondary")">@x.Status</span></td><td><a asp-action="Edit" asp-route-id="@x.CustomerId">Edit</a></td></tr>}</tbody></table></div>
