@{ ViewData["Title"]="Reports"; }<h1>Reports</h1><div class="row g-3"><div class="col-md-4"><div class="card"><div class="card-header">Customer Status</div><div class="card-body">@foreach(var x in ViewBag.Customers){<div class="d-flex justify-content-between"><span>@x.Label</span><b>@x.Count</b></div>}</div></div></div><div class="col-md-4"><div class="card"><div class="card-header">Lead Status</div><div class="card-body">@foreach(var x in ViewBag.Leads){<div class="d-flex justify-content-between"><span>@x.Label</span><b>@x.Count</b></div>}</div></div></div><div class="col-md-4"><div class="card"><div class="card-header">Pipeline by Stage</div><div class="card-body">@foreach(var x in ViewBag.Opportunities){<div class="d-flex justify-content-between"><span>@x.Label</span><b>@x.Amount.ToString("C")</b></div>}</div></div></div></div>
